#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --job-name=run_pipeline
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=24:00:00
#SBATCH --output=slurm_outputs/%A_pipeline.out

if [[ $(hostname) == *"snellius"* ]]; then
  module purge
  module load 2024
  module load Miniconda3/24.7.1-0
  source "$(conda info --base)/etc/profile.d/conda.sh"
  conda deactivate
  conda activate clarify-env-3.12

  # Monitor GPU usage every 30 seconds and log to file
  nvidia-smi --query-gpu=timestamp,name,utilization.gpu,memory.used,memory.free,power.draw --format=csv -l 30 > slurm_outputs/gpu_utilization_${SLURM_JOB_ID}.csv &
  NVIDIA_SMI_PID=$!
fi

SPLIT="dev"
SEED=50
if [[ "${SPLIT}" == "train" ]]; then MAX_EXAMPLES=1000; else MAX_EXAMPLES=2000; fi

MODEL_NAMES=(
  "olmo2-7b-instruct"
  "olmo2-13b-instruct"
  "olmo3-7b-instruct"
  "qwen3-8b"
  "qwen3-14b"
  "gemini-2.5-flash"
#  "olmo3-7b-think"
#  "qwen3-8b-think"
)

DIRECT_PROMPTS=(
  "vanilla"
  "concise"
  "sentence"
)

BELIEF_SAMPLINGS=(
  "unbiased"
)

## DIRECT & DISAMBIGUATED
 for MODEL_NAME in "${MODEL_NAMES[@]}"; do
   for DIRECT_PROMPT in "${DIRECT_PROMPTS[@]}"; do
     for BELIEF_SAMPLING in "${BELIEF_SAMPLINGS[@]}"; do
       python pipeline.py \
         --max_examples ${MAX_EXAMPLES} \
         --assistant_model ${MODEL_NAME} \
         --direct_prompt ${DIRECT_PROMPT} \
         --belief_sampling ${BELIEF_SAMPLING} \
         --seed ${SEED} \
         --n_samples 10 \
         --split ${SPLIT} \
         --filter_conflicts \
         --api_processing sync \
         --force \
         --steps direct disambiguated
     done
   done
 done

REASONER_PROMPTS=(
  "belief"
#  "belief1"
#  "belief2"
#  "belief3"
#  "belief4"
#  "belief5"
  "belief6"
  "belief7"
#  "belief8"
)
USER_MODEL="gemini-2.5-flash"
#USER_MODEL="haiku4.5"

FINAL_PROMPTS=(
  "prompt"
  "prompt1"
  "belief"
)

for MODEL_NAME in "${MODEL_NAMES[@]}"; do
  # prompt reasoner: re-run with --force to overwrite incomplete 1k files
  python pipeline.py \
      --max_examples ${MAX_EXAMPLES} \
      --assistant_model ${MODEL_NAME} \
      --user_model ${USER_MODEL} \
      --reasoner_prompt prompt \
      --direct_prompt ${DIRECT_PROMPTS[0]} \
      --seed ${SEED} \
      --split ${SPLIT} \
      --filter_conflicts \
      --api_processing sync \
      --force \
      --steps reasoner user

  for FINAL_PROMPT in "${FINAL_PROMPTS[@]}"; do
    python pipeline.py \
      --max_examples ${MAX_EXAMPLES} \
      --assistant_model ${MODEL_NAME} \
      --user_model ${USER_MODEL} \
      --reasoner_prompt prompt \
      --direct_prompt ${DIRECT_PROMPTS[0]} \
      --final_prompt ${FINAL_PROMPT} \
      --seed ${SEED} \
      --split ${SPLIT} \
      --filter_conflicts \
      --api_processing sync \
      --force \
      --steps final
  done

  # BELIEF-BASED REASONER + DOWNSTREAM INTERACTION
   for DIRECT_PROMPT in "${DIRECT_PROMPTS[@]}"; do
     for BELIEF_SAMPLING in "${BELIEF_SAMPLINGS[@]}"; do
       for REASONER_PROMPT in "${REASONER_PROMPTS[@]}"; do
         python pipeline.py \
           --max_examples ${MAX_EXAMPLES} \
           --assistant_model ${MODEL_NAME} \
           --user_model ${USER_MODEL} \
           --reasoner_prompt ${REASONER_PROMPT} \
           --direct_prompt ${DIRECT_PROMPT} \
           --belief_sampling ${BELIEF_SAMPLING} \
           --seed ${SEED} \
           --split ${SPLIT} \
           --filter_conflicts \
           --api_processing sync \
           --force \
           --steps reasoner user

         for FINAL_PROMPT in "${FINAL_PROMPTS[@]}"; do
           python pipeline.py \
             --max_examples ${MAX_EXAMPLES} \
             --assistant_model ${MODEL_NAME} \
             --user_model ${USER_MODEL} \
             --reasoner_prompt ${REASONER_PROMPT} \
             --direct_prompt ${DIRECT_PROMPT} \
             --belief_sampling ${BELIEF_SAMPLING} \
             --final_prompt ${FINAL_PROMPT} \
             --seed ${SEED} \
             --split ${SPLIT} \
             --filter_conflicts \
             --api_processing sync \
             --force \
             --steps final
         done
       done
     done
   done
done


# Stop monitoring before waiting, so nvidia-smi doesn't block the wait
if [[ $(hostname) == *"snellius"* ]]; then
  kill $NVIDIA_SMI_PID 2>/dev/null || true
fi

wait
